# Flask Secret Key
SECRET_KEY=your-secret-key-change-me

# Database Backend: 'sqlite' (default) or 'mysql'
DB_BACKEND=sqlite

# Copyleaks API Configuration (Internet Plagiarism Scan)
COPYLEAKS_EMAIL=your-copyleaks-email
COPYLEAKS_API_KEY=your-api-key
COPYLEAKS_SANDBOX=false

# Copyleaks Webhook Configuration (e.g. ngrok HTTPS URL for local dev)
COPYLEAKS_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.dev
COPYLEAKS_WEBHOOK_SECRET=your-webhook-secret
